{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "환경 설정",
      "type": "shell",
      "command": "bash",
      "args": ["setup.sh"],
      "windows": {
        "command": "powershell",
        "args": ["-ExecutionPolicy", "Bypass", "-File", "setup.ps1"]
      },
      "problemMatcher": []
    },
    {
      "label": "전체 테스트",
      "type": "shell",
      "command": "bash",
      "args": ["-c", "[ -d .venv ] || bash setup.sh; .venv/bin/python -m pytest"],
      "windows": {
        "command": "powershell",
        "args": ["-c", "if (!(Test-Path .venv)) { .\\setup.ps1 }; .\\.venv\\Scripts\\python.exe -m pytest"]
      },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "특정 번호만 테스트",
      "type": "shell",
      "command": "bash",
      "args": ["-c", "[ -d .venv ] || bash setup.sh; .venv/bin/python -m pytest -k problem_${input:problem}"],
      "windows": {
        "command": "powershell",
        "args": ["-c", "if (!(Test-Path .venv)) { .\\setup.ps1 }; .\\.venv\\Scripts\\python.exe -m pytest -k problem_${input:problem}"]
      },
      "group": "test",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "problem",
      "type": "promptString",
      "description": "문제 번호 (예: 01)",
      "default": "01"
    }
  ]
}
